# Copy to agents/finguard_agent/.env (gitignored). `adk web` / `adk run` load it automatically.

# --- Model (pick one) ---------------------------------------------------------
FINGUARD_AGENT_MODEL=ollama_chat/qwen3-coder:30b
OLLAMA_API_BASE=http://localhost:11434

# Gemini via Google AI Studio:
# FINGUARD_AGENT_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=your-key

# Gemini via Vertex AI (uses `gcloud auth application-default login`):
# FINGUARD_AGENT_MODEL=gemini-2.5-flash
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# OpenAI via LiteLLM:
# FINGUARD_AGENT_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=your-key

# --- Optional tools -----------------------------------------------------------
FINGUARD_ENABLE_DRIVE=0
# FINGUARD_GOOGLE_OAUTH_TOKEN_FILE=.secrets/drive_token.json
# FINGUARD_GOOGLE_OAUTH_SECRET=projects/your-project-id/secrets/finguard-drive-token/versions/latest
FINGUARD_ENABLE_SQL=0
# FINGUARD_SQL_DB=data/finguard_internal.db

# --- Tracing ------------------------------------------------------------------
FINGUARD_CLOUD_TRACE=0
