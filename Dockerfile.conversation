# syntax=docker/dockerfile:1
# Conversation API image: LangGraph + PostgreSQL/Redis + the existing FAISS retriever.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/huggingface \
    TOKENIZERS_PARALLELISM=false

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-conversation.txt ./

# CPU-only PyTorch first so the image does not pull CUDA packages.
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch \
    && pip install -r requirements.txt -r requirements-conversation.txt

# Bake the embedding model and reranker into the image (loaded once at runtime).
RUN python -c "from sentence_transformers import SentenceTransformer, CrossEncoder; SentenceTransformer('BAAI/bge-base-en-v1.5'); CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')"

COPY src ./src
COPY conversation ./conversation
COPY config ./config
COPY api ./api
COPY vectorstore ./vectorstore

RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app /opt/huggingface
USER appuser

EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn api.conversation_api:app --host 0.0.0.0 --port ${PORT:-8080}"]
